{
  "name": "uptime-monitor",
  "version": "1.0.0",
  "description": "Uptime monitoring API: scheduled HTTP checks, incidents, email alerts (Node, Express, MongoDB, Agenda)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --env-file-if-exists=.env scripts/demo.js"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.5",
    "agenda": "^6.2.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
