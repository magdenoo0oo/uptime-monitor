NODE_ENV=development
PORT=4100
MONGO_URL=mongodb://127.0.0.1:27017/uptime_monitor
APP_URL=http://localhost:4100
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*
LOG_LEVEL=info

# Background jobs: false = API only (run `npm run worker` separately)
RUN_WORKER=true
JOBS_PROCESS_EVERY_MS=5000
CHECK_CONCURRENCY=20

# Checks
CHECK_RETRIES=2
CHECK_RETRY_BASE_MS=2000
CHECKS_RETENTION_DAYS=90
MAX_MONITORS_PER_USER=50
# true lets you monitor localhost/private IPs (local dev, `npm run demo`). Keep false in production.
ALLOW_PRIVATE_TARGETS=false

# Email alerts. Leave SMTP_URL empty to log emails instead of sending them.
# Free testing inbox: https://mailtrap.io → smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525
SMTP_URL=
MAIL_FROM=Uptime Monitor <alerts@uptime.local>
ALERT_RETRY_BASE_MS=30000
ALERT_MAX_RETRIES=5
